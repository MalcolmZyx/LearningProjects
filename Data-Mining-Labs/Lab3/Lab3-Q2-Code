# --- Part 2: Object-Oriented Program Definition ---

class myMatrix:
    def GetMatrix(self, N, filename):
        """
        Reads N*N numbers from a file and returns an NxN numpy matrix.
        """
        try:
            with open(filename, 'r') as f:
                # Read file, split into numbers, and convert to integers
                numbers = list(map(int, f.read().split()))
        except FileNotFoundError:
            # Exit if the file does not exist
            sys.exit(f"Error: ***** File '{filename}' not found. The program stops in here.")
        
        # Check if there are enough numbers in the file using short-circuiting
        (len(numbers) < N*N) and sys.exit(f"Error: ***** Not enough numbers in {filename} for a {N}x{N} matrix.")
        
        # Take the first N*N numbers, convert to a numpy array, and reshape into an NxN matrix
        matrix = np.array(numbers[:N*N]).reshape((N, N))
        return matrix

    def Product(self, M1, M2):
        """
        Calculates the element-by-element product of two matrices.
        """
        return M1 * M2

    def DotProduct(self, M1, M2):
        """
        Calculates the standard matrix multiplication (dot product) of two matrices.
        """
        return np.dot(M1, M2)

    def Division(self, M1, M2):
        """
        Performs element-by-element division. Returns 'undef' for any division by zero.
        Formats the result to two decimal places.
        """
        # Create a result matrix of type 'object' filled with 'undef'
        result_matrix = np.full(M1.shape, 'undef', dtype=object)
        
        # Use a context manager to suppress warnings for division by zero
        with np.errstate(divide='ignore', invalid='ignore'):
            # Perform the division, which will result in 'inf' or 'nan' for zeros
            division_result = M1.astype(float) / M2.astype(float)
        
        # Create a boolean mask to identify where the division resulted in a finite number
        is_finite_mask = np.isfinite(division_result)
        
        # Get the finite values from the division result
        finite_values = division_result[is_finite_mask]
        
        # Format the finite values to strings with 2 decimal places using a vectorized operation
        formatted_values = np.char.mod('%.2f', finite_values)
        
        # Place the formatted strings back into the result matrix where the values were finite
        result_matrix[is_finite_mask] = formatted_values
        
        return result_matrix
        
def print_matrix(M, title):
    """
    Helper function to print a matrix with a title and consistent formatting.
    """
    print(title)
    # Use numpy's savetxt to print the array to the console with tab delimiters
    # The '%s' format handles both numbers and strings (like 'undef') correctly
    np.savetxt(sys.stdout, M, fmt='%s', delimiter='\t')
    print("=================================================================================")

